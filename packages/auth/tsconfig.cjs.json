{
  "extends": "./tsconfig.build.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Bundler",
    "outDir": "dist/cjs",
    "rootDir": "src",
    "declaration": true,
    "declarationMap": true,
    "verbatimModuleSyntax": false
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "src/utils/seed.ts",
    "src/server.ts",
    "src/migrate.ts",
    "src/**/*.test.ts"
  ]
}
