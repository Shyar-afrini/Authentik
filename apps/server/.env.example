# Authentik server: owns its own Postgres database; nothing here is shared with the apps it serves.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/authentik
BETTER_AUTH_SECRET=            # >= 32 random characters (openssl rand -base64 48)
BETTER_AUTH_URL=http://localhost:3005   # public URL of this server

AUTH_PORT=3005
# Where the dashboard runs. Sign-in/consent pages live there, and it is trusted for CORS by default.
AUTH_DASHBOARD_URL=http://localhost:3006
AUTH_TRUSTED_ORIGINS=http://localhost:3006
# Optional
# Session cache, rate limits, app-key invalidation. Local: docker compose -f infrastructure/docker/redis.compose.yml up -d
REDIS_URL=redis://localhost:6395
# Extra browser origins allowed to call this server with credentials (comma separated).
# Defaults to AUTH_DASHBOARD_URL, so only set it when other frontends need access.
# AUTH_TRUSTED_ORIGINS=http://localhost:3006,http://localhost:3000
# AUTH_TRUSTED_PROXIES=10.0.0.0/8
# AUTH_COOKIE_DOMAIN=example.com
# AUTH_DB_POOL_MAX=10
# AUTH_METRICS_TOKEN=
